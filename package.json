{
  "name": "koishi-plugin-sswm",
  "description": "把群友的图片上传到各自的 QQ 群相册",
  "version": "0.0.5",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --outfile=lib/index.js --format=cjs --platform=node --target=es2022 --packages=external",
    "test": "tsx --test test/*.spec.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "files": [
    "lib",
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xboHodx/koishi-plugin-sswm.git"
  },
  "bugs": {
    "url": "https://github.com/xboHodx/koishi-plugin-sswm/issues"
  },
  "homepage": "https://github.com/xboHodx/koishi-plugin-sswm#readme",
  "keywords": [
    "chatbot",
    "koishi",
    "qq",
    "album",
    "napcat"
  ],
  "koishi": {
    "description": {
      "zh": "引用一张图片，把它上传到群相册",
      "en": "Upload quoted images to QQ group albums"
    }
  },
  "peerDependencies": {
    "koishi": "^4.18.11"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "esbuild": "^0.23.1",
    "koishi": "^4.18.11",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
